<Project Sdk="Microsoft.NET.Sdk">

  <!--
    标注引擎的离线自检工程 (非产品代码)。
    直接链接产品源码中的标注相关文件, 避免复制粘贴导致验证对象与实际代码不一致。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SnipasteOcr.Tests</RootNamespace>
    <AssemblyName>AnnotationTests</AssemblyName>
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <!-- 该工程只用于本地验证, 不参与 AOT 发布 -->
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Annotations\Annotation.cs" Link="Engine\Annotation.cs" />
    <Compile Include="..\..\src\Annotations\AnnotationTool.cs" Link="Engine\AnnotationTool.cs" />
    <Compile Include="..\..\src\Annotations\AnnotationEngine.cs" Link="Engine\AnnotationEngine.cs" />
    <Compile Include="..\..\src\Annotations\AnnotationHistory.cs" Link="Engine\AnnotationHistory.cs" />
    <Compile Include="..\..\src\Annotations\AnnotationToolbar.cs" Link="Engine\AnnotationToolbar.cs" />
    <Compile Include="..\..\src\Annotations\TextEditorOverlay.cs" Link="Engine\TextEditorOverlay.cs" />
    <Compile Include="..\..\src\Annotations\UiFont.cs" Link="Engine\UiFont.cs" />
    <!-- 界面配色唯一来源 (标注工具栏/尺寸徽标引用) -->
    <Compile Include="..\..\src\UiTheme.cs" Link="Engine\UiTheme.cs" />
    <!-- 高倍缩放平移的夹紧几何 (结果窗口与离线断言共用) -->
    <Compile Include="..\..\src\OcrPan.cs" Link="Engine\OcrPan.cs" />
    <!-- 框选尺寸徽标与「逻辑选区 → 导出物理矩形」的单一来源 -->
    <Compile Include="..\..\src\SnipGeometry.cs" Link="Engine\SnipGeometry.cs" />
    <Compile Include="..\..\src\SnipSizeBadge.cs" Link="Engine\SnipSizeBadge.cs" />
    <!-- 设置模型与迁移 (不依赖 OCR 引擎, 故枚举单独成文件) -->
    <Compile Include="..\..\src\AppSettings.cs" Link="Engine\AppSettings.cs" />
    <Compile Include="..\..\src\OcrModelProfile.cs" Link="Engine\OcrModelProfile.cs" />
    <!-- OCR 结果后处理 (纯函数): OcrText.cs 依赖 SDK 的检测框类型, 故需引用该包 -->
    <Compile Include="..\..\src\OcrText.cs" Link="Engine\OcrText.cs" />
    <Compile Include="..\..\src\OcrBox.cs" Link="Engine\OcrBox.cs" />
    <!-- 选词几何纯函数 (字符索引反解 / 阅读顺序名次), 结果窗口本身依赖 WinForms 不进离线工程 -->
    <Compile Include="..\..\src\OcrSelection.cs" Link="Engine\OcrSelection.cs" />
    <!-- CTC 字符框布局 (纯函数): 真实字符框 -> 光标边界/高亮, 不可用时回退权重 -->
    <Compile Include="..\..\src\OcrGlyphLayout.cs" Link="Engine\OcrGlyphLayout.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Sdcb.SimdPaddleOCR" Version="2.0.0" />
  </ItemGroup>

</Project>
