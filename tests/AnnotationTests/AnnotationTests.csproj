<Project Sdk="Microsoft.NET.Sdk">

  <!--
    标注引擎的离线自检工程 (非产品代码)。
    直接链接产品源码中的标注相关文件, 避免复制粘贴导致验证对象与实际代码不一致。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SnipasteOcr.Tests</RootNamespace>
    <AssemblyName>AnnotationTests</AssemblyName>
    <_SuppressWinFormsTrimError>true</_SuppressWinFormsTrimError>
    <!-- 该工程只用于本地验证, 不参与 AOT 发布 -->
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Annotations\Annotation.cs" Link="Engine\Annotation.cs" />
    <Compile Include="..\..\src\Annotations\AnnotationTool.cs" Link="Engine\AnnotationTool.cs" />
    <Compile Include="..\..\src\Annotations\AnnotationDrag.cs" Link="Engine\AnnotationDrag.cs" />
    <Compile Include="..\..\src\Annotations\AnnotationEngine.cs" Link="Engine\AnnotationEngine.cs" />
    <Compile Include="..\..\src\Annotations\AnnotationHistory.cs" Link="Engine\AnnotationHistory.cs" />
    <Compile Include="..\..\src\Annotations\AnnotationToolbar.cs" Link="Engine\AnnotationToolbar.cs" />
    <!-- 颜色/线宽的唯一来源 (工具栏预览、样式弹层、断言共用) -->
    <Compile Include="..\..\src\Annotations\AnnotationPalette.cs" Link="Engine\AnnotationPalette.cs" />
    <!-- 颜色与线宽弹层 (布局/绘制/命中; 打开时才创建窗口, 离线断言直接调 OnPaint) -->
    <Compile Include="..\..\src\Annotations\StylePopupForm.cs" Link="Engine\StylePopupForm.cs" />
    <!-- 弹层在句柄创建后申请 Win11 圆角 (DwmSetWindowAttribute); 纯 P/Invoke, 无窗体依赖 -->
    <Compile Include="..\..\src\NativeMethods.cs" Link="Engine\NativeMethods.cs" />
    <Compile Include="..\..\src\Annotations\TextEditorOverlay.cs" Link="Engine\TextEditorOverlay.cs" />
    <Compile Include="..\..\src\Annotations\UiFont.cs" Link="Engine\UiFont.cs" />
    <!-- 标注选中 / 层级 / 选区手柄 (纯几何, 与窗体状态机解耦) -->
    <Compile Include="..\..\src\Annotations\AnnotationHit.cs" Link="Engine\AnnotationHit.cs" />
    <Compile Include="..\..\src\Annotations\AnnotationOrder.cs" Link="Engine\AnnotationOrder.cs" />
    <Compile Include="..\..\src\Annotations\AnnotationSelection.cs" Link="Engine\AnnotationSelection.cs" />
    <Compile Include="..\..\src\Annotations\SelectionResize.cs" Link="Engine\SelectionResize.cs" />
    <!-- 界面配色唯一来源 (标注工具栏/尺寸徽标引用) -->
    <Compile Include="..\..\src\UiTheme.cs" Link="Engine\UiTheme.cs" />
    <!-- 高倍缩放平移的夹紧几何 (结果窗口与离线断言共用) -->
    <Compile Include="..\..\src\OcrPan.cs" Link="Engine\OcrPan.cs" />
    <!-- 置信度展示规则 (低分框标色/状态栏百分比) -->
    <Compile Include="..\..\src\OcrConfidence.cs" Link="Engine\OcrConfidence.cs" />
    <!-- 框选尺寸徽标与「逻辑选区 → 导出物理矩形」的单一来源 -->
    <Compile Include="..\..\src\SnipGeometry.cs" Link="Engine\SnipGeometry.cs" />
    <Compile Include="..\..\src\SnipSizeBadge.cs" Link="Engine\SnipSizeBadge.cs" />
    <!-- 放大镜/取色器纯逻辑 (布局/采样/格式化) -->
    <Compile Include="..\..\src\SnipMagnifier.cs" Link="Engine\SnipMagnifier.cs" />
    <!-- 贴图窗口的尺寸/缩放/透明度/锚点纯函数 -->
    <Compile Include="..\..\src\PinnedImageLayout.cs" Link="Engine\PinnedImageLayout.cs" />
    <!-- 设置模型与迁移 (不依赖 OCR 引擎, 故枚举单独成文件) -->
    <Compile Include="..\..\src\AppSettings.cs" Link="Engine\AppSettings.cs" />
    <Compile Include="..\..\src\OcrModelProfile.cs" Link="Engine\OcrModelProfile.cs" />
    <!-- OCR 结果后处理 (纯函数): OcrText.cs 依赖 SDK 的检测框类型, 故需引用该包 -->
    <Compile Include="..\..\src\OcrText.cs" Link="Engine\OcrText.cs" />
    <!-- 表格网格中间模型 (CSV / XLSX / Markdown 表格的唯一来源) -->
    <Compile Include="..\..\src\OcrTable.cs" Link="Engine\OcrTable.cs" />
    <Compile Include="..\..\src\OcrBox.cs" Link="Engine\OcrBox.cs" />
    <!-- 选词几何纯函数 (字符索引反解 / 阅读顺序名次), 结果窗口本身依赖 WinForms 不进离线工程 -->
    <Compile Include="..\..\src\OcrSelection.cs" Link="Engine\OcrSelection.cs" />
    <!-- CTC 字符框布局 (纯函数): 真实字符框 -> 光标边界/高亮, 不可用时回退权重 -->
    <Compile Include="..\..\src\OcrGlyphLayout.cs" Link="Engine\OcrGlyphLayout.cs" />
    <!-- 翻译客户端与 Key 保护 (纯逻辑 + HTTP/DPAPI, 不依赖桌面会话) -->
    <Compile Include="..\..\src\TranslateClient.cs" Link="Engine\TranslateClient.cs" />
    <Compile Include="..\..\src\ProtectedKey.cs" Link="Engine\ProtectedKey.cs" />
    <!-- 结果窗口底部译文条的布局 (绘制/命中/状态栏避让的唯一来源) -->
    <Compile Include="..\..\src\TranslateBarLayout.cs" Link="Engine\TranslateBarLayout.cs" />
    <!-- 悬停「译」按钮的布局 (翻译的独立入口; 绘制与命中取同一份几何) -->
    <Compile Include="..\..\src\TranslateHoverButton.cs" Link="Engine\TranslateHoverButton.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Sdcb.SimdPaddleOCR" Version="2.0.0" />
  </ItemGroup>

</Project>
